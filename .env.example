# ==============================
# 新西兰旅行规划 - 环境变量模板
# 复制此文件为 .env 并填入真实值
# ==============================

# ---- Supabase 配置（必填）----
# 在 Supabase 控制台创建项目后获取
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ---- MetService 天气 API 配置（可留空使用Mock数据）----
# MetService API Key (https://about.metservice.com/)
VITE_METSERVICE_API_KEY=

# ---- 后端服务配置 ----
# 开发模式下后端端口
VITE_API_BASE_URL=/api
